{
  "name": "physis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "server:build": "vp pack server/main.ts --no-config --out-dir dist-server --tsconfig tsconfig.server.json",
    "server": "pnpm build && pnpm server:build && node --env-file-if-exists=.env.local dist-server/main.mjs",
    "remote:token": "node scripts/remote-token.mjs",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "gifenc": "1.0.3",
    "p5": "^2.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/p5": "^1.7.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.1.0"
  },
  "packageManager": "pnpm@12.6.0"
}
